page{background:#f7f8f2;color:#344c3e;font-family:sans-serif}.page{padding:30rpx}.top,.row,.toolbar,.sheet-top{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.title{display:block;font-size:42rpx;font-weight:700}.subtitle,.hint{display:block;font-size:24rpx;color:#7a896f;margin:14rpx 0;line-height:1.8}.banner{background:#e7eedb;border-radius:24rpx;padding:38rpx;margin:28rpx 0;line-height:1.8}.large{display:block;font-size:38rpx;font-weight:600}.toolbar{margin:22rpx 0}.search,.editor input,.editor textarea{box-sizing:border-box;background:#fffef8;border:1rpx solid #dfe5d6;border-radius:12rpx;padding:20rpx;width:100%;margin:12rpx 0 24rpx}.categories{white-space:nowrap;margin:24rpx 0}.category{display:inline-block;padding:13rpx 22rpx;background:#edf1e7;border-radius:30rpx;margin-right:12rpx;font-size:26rpx}.active,.primary{background:#344c3e!important;color:#fff!important}.card{background:#fffef8;border:1rpx solid #e2e6da;border-radius:20rpx;padding:28rpx;margin-bottom:22rpx}.dishname{font-size:34rpx;font-weight:600}.tag{font-size:22rpx;font-weight:400;background:#edf1e7;border-radius:8rpx;padding:6rpx 10rpx}.note{font-size:26rpx;color:#7b8a70;display:block;margin:18rpx 0;line-height:1.8}.meta{font-size:24rpx;color:#78866e;margin:20rpx 0}.row{margin-top:24rpx}button{font-size:28rpx!important;background:#edf1e7;color:#344c3e;border-radius:12rpx}button::after{border:none}.mask{position:fixed;inset:0;background:rgba(25,40,30,.38);z-index:100;display:flex;align-items:flex-end}.sheet{box-sizing:border-box;max-height:90vh;background:#fffef8;border-radius:30rpx 30rpx 0 0;padding:32rpx;padding-bottom:calc(40rpx + env(safe-area-inset-bottom));width:100%}.sheet-top{padding-bottom:24rpx;border-bottom:1rpx solid #e5e9dd}.section{font-size:30rpx;font-weight:600;margin:34rpx 0 16rpx}.line{font-size:28rpx;line-height:1.9;padding:6rpx 0}.editor label{display:block;font-size:27rpx;margin-top:25rpx}.editor textarea{height:180rpx}.plain{background:transparent!important;margin-top:22rpx}.empty{padding:70rpx 0;color:#859376;text-align:center}.error{color:#a75138;font-size:26rpx;margin:24rpx 0;line-height:1.8}
